unit uDtmVenda;

interface

uses
  System.SysUtils, System.Classes, Data.DB, ZAbstractRODataset,
  ZAbstractDataset, ZDataset,uDtmDados, Datasnap.DBClient;

type
  TdtmVenda = class(TDataModule)
    QryClientes: TZQuery;
    QryClientesclienteId: TZIntegerField;
    QryClientesnome: TZUnicodeStringField;
    QryProdutos: TZQuery;
    QryProdutosprodutoId: TZIntegerField;
    QryProdutosnome: TZUnicodeStringField;
    QryProdutosvalor: TZFMTBCDField;
    QryProdutosquantidade: TZFMTBCDField;
    dtsCliente: TDataSource;
    dtsProdutos: TDataSource;
    dtsItensVenda: TDataSource;
    cdsItensVenda: TClientDataSet;
    procedure DataModuleCreate(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  dtmVenda: TdtmVenda;

implementation

{%CLASSGROUP 'Vcl.Controls.TControl'}



{$R *.dfm}

procedure TdtmVenda.DataModuleCreate(Sender: TObject);
begin
   //grantindo que sempre que dtm for accionado os dados vão estar atualizados

  cdsItensVenda.CreateDataSet;
  QryClientes.Open;
  QryProdutos.Open;
end;

end.
